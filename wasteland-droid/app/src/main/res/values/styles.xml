<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorPrimary">@color/fg</item>
        <item name="android:colorAccent">@color/fg</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:alertDialogTheme">@style/AppDialog</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
    <style name="AppDialog" parent="@android:style/Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">@color/fg</item>
        <item name="android:colorBackground">@color/bg2</item>
        <item name="android:textColorPrimary">@color/fg</item>
        <item name="android:textColor">@color/fg</item>
        <item name="android:fontFamily">monospace</item>
    </style>
</resources>
