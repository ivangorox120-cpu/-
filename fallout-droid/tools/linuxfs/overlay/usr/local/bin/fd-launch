#!/bin/bash
# Fallout Droid: start Fallout 3 / New Vegas straight into the game, also on the very first run.
#
#   fd-launch SCOPE GAME_DIR GAME_EXE MY_GAMES_FOLDER REGISTRY_FOLDER
#
# Without Fallout.ini in "My Games" (and without the installer keys) the game opens Bethesda's
# launcher instead of itself. Before the game starts this script
#   1. creates the Proton prefix by running Wine's reg.exe, which also writes the installer keys
#      in both registry views (no hand edits of system.reg);
#   2. puts the ini files the app prepared into every "Documents\My Games" Wine may use;
#   3. starts the game.
scope=$1 dir=$2 exe=$3 folder=$4 regfolder=$5
log() { echo "fd-launch: $*" >&2; }
run() { /usr/local/bin/droiddeck-proton-run --app "$scope" --dir "$dir" -- "$@"; }

home=${HOME:-/root}
root=$home/.local/share/Steam
pfx=$root/steamapps/compatdata/$scope/pfx
stage=$home/.local/share/fallout-droid/ini/$folder
marker=$pfx/.fallout-droid-registry-$regfolder
tooldirs=("$root/compatibilitytools.d" /usr/share/steam/compatibilitytools.d /usr/local/share/steam/compatibilitytools.d)

find_wine_tool() {
  local name=$1 base found
  for base in "${tooldirs[@]}"; do
    [ -d "$base" ] || continue
    found=$(find -L "$base" -maxdepth 8 -type f -iname "$name" -path '*windows*' 2>/dev/null \
      | awk '/aarch64-windows/{print 0" "$0; next} /x86_64-windows/{print 1" "$0; next} {print 2" "$0}' | sort | head -1 | cut -d' ' -f2-)
    [ -n "$found" ] && { echo "$found"; return 0; }
  done
  return 1
}

log "prefix $pfx ($( [ -f "$pfx/system.reg" ] && echo exists || echo new ))"
if [ ! -f "$marker" ]; then
  win="Z:${dir//\//\\}\\"
  regexe=$(find_wine_tool reg.exe)
  if [ -n "$regexe" ]; then
    log "writing the installer keys with $regexe"
    key="HKLM\\Software\\Bethesda Softworks\\$regfolder"
    ok=1
    for view in /reg:32 /reg:64; do
      run "$regexe" add "$key" /v "Installed Path" /t REG_SZ /d "$win" /f $view || ok=0
      run "$regexe" add "$key" /v "Installed" /t REG_DWORD /d 1 /f $view || true
    done
    [ "$ok" = 1 ] && [ -f "$pfx/system.reg" ] && touch "$marker"
  else
    wineboot=$(find_wine_tool wineboot.exe)
    if [ -n "$wineboot" ] && [ ! -f "$pfx/system.reg" ]; then
      log "no reg.exe; creating the prefix with $wineboot"
      run "$wineboot" -u || true
    else
      log "no reg.exe found in: ${tooldirs[*]}"
    fi
  fi
fi

place_ini() {
  local docs=$1 games
  games="$docs/My Games/$folder"
  mkdir -p "$games" 2>/dev/null || return
  for ini in Fallout.ini FalloutPrefs.ini; do
    [ -f "$stage/$ini" ] || continue
    if [ ! -s "$games/$ini" ]; then
      cp "$stage/$ini" "$games/$ini" && log "placed $ini in $games"
    fi
  done
}
if [ -d "$stage" ]; then
  for user in "$pfx"/drive_c/users/*/; do
    [ -d "$user" ] || continue
    case $(basename "$user") in Public|public) continue ;; esac
    for docs in "$user/Documents" "$user/My Documents"; do
      [ -e "$docs" ] && place_ini "$docs"
    done
    [ -e "$user/Documents" ] || [ -e "$user/My Documents" ] || place_ini "$user/Documents"
    log "user $(basename "$user"): Documents -> $(readlink -f "$user/Documents" 2>/dev/null)"
  done
  [ -d "$home/Documents" ] && place_ini "$home/Documents"
else
  log "no prepared ini in $stage"
fi
find "$pfx/drive_c/users" "$home/Documents" -maxdepth 6 -iname 'Fallout*.ini' 2>/dev/null | sed 's/^/fd-launch: ini /' >&2

exec /usr/local/bin/droiddeck-proton-run --app "$scope" --dir "$dir" -- "$exe"
